POSTGRES_DB=sar
POSTGRES_USER=sar
POSTGRES_PASSWORD=replace-with-a-strong-password
SAR_DATA_DIR=./tiff
# 临时入库区。数据会从此目录移动到 SAR_DATA_DIR 对应的数据源目录。
SAR_UPLOAD_DIR=/upload
# Staging location for files copied from approved LAN servers.
TRANSFER_DESTINATION_ROOT=/upload
# A JSON mapping of server IDs to read-only directories mounted into the API
# container. Do not put server passwords or arbitrary network URLs here.
# Host directory mounted at /transfer-sources in the API container.
SAR_TRANSFER_SOURCE_DIR=./transfer-sources
# TRANSFER_SOURCE_ROOTS={"sar-storage-01":"/transfer-sources/sar-storage-01"}
TRANSFER_SOURCE_ROOTS={}
SAR_API_PORT=8000
# 对外分享文件 URL 使用的服务地址；留空时使用当前请求的主机和端口。
PUBLIC_BASE_URL=
# 扫描器独立运行；默认最多占用 1 个 CPU，并降低调度优先级以保障查询接口。
SCANNER_CPUS=1.0
SCANNER_NICE=15
# 每写入一份发生变化的数据后等待的毫秒数；提高该值可进一步优先保障查询响应。
SCANNER_WRITE_DELAY_MS=20
CORS_ORIGINS=*
DOCKER_PLATFORM=linux/amd64
POSTGIS_IMAGE=postgis/postgis:16-3.5
SAR_API_IMAGE=sar-manager-api:0.2.4
